      "companyChangedFields": { "type": "array", "title": "Changed company fields", "items": { "type": "string" } },
      "sourceQuality": { "type": "string", "title": "Source quality", "enum": ["complete", "partial"] },
      "scrapedAt": { "type": "string", "title": "Observed at" }
