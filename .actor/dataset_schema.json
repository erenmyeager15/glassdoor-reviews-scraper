  "views": {
    "reviews": {
      "title": "Reviews and employer-brand changes",
      "transformation": {
        "fields": [
          "companyName", "overallRating", "ratingBand", "headline", "pros", "cons", "jobTitle",
          "employmentStatus", "employmentType", "isCurrentEmployee", "employmentTenure", "employmentTenureYears", "location", "reviewDate",
