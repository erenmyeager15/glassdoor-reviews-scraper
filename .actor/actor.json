{
  "actorSpecification": 1,
  "name": "glassdoor-reviews-scraper",
  "title": "Glassdoor Reviews Scraper & Employer Brand Monitor",
  "description": "Collect public Glassdoor employee reviews, ratings and employer replies for employer-brand research. Track new reviews and rating changes with named watchlists and CSV/Markdown reports. $4/1,000 saved reviews plus the start event. No login.",
  "version": "1.5",
  "buildTag": "quality-recovery-20261016",
  "categories": ["BUSINESS", "JOBS", "MARKETING"],
  "categoriesVersion": "1.0.0",
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "exampleRunInput": {
    "body": "{\"companyUrls\":[\"https://www.glassdoor.com/Reviews/Google-Reviews-E9079.htm\"],\"maxReviewsPerCompany\":3,\"watchlistName\":\"default\",\"onlyNewReviews\":false,\"useUnblocker\":true,\"maxRunMinutes\":5}",
    "contentType": "application/json; charset=utf-8"
  },
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "review-scraped": {
          "eventTitle": "Review scraped",
          "eventDescription": "Charged only for each Glassdoor review successfully extracted and saved to the dataset.",
          "eventPriceUsd": 0.004,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 256,
    "timeoutSecs": 600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 512
}
